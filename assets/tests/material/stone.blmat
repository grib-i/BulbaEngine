material "Stone"
{
    domain = 3d

    render
    {
        mode = opaque

        alpha_mode = opaque
        alpha_cutoff = 0.5

        lighting = true
        depth_test = true
        depth_write = true

        double_sided = false
        unlit = false
    }

    base
    {
        color = [1.0, 1.0, 1.0, 1.0]

        metallic = 0.0
        roughness = 0.65

        normal_scale = 1.0
        occlusion_strength = 1.0
    }

    emission
    {
        color = [1.0, 1.0, 1.0, 1.0]
        strength = 0.0
    }

    specular
    {
        factor = 1.0
        color = [1.0, 1.0, 1.0]
    }

    ior = 1.5

    transmission
    {
        factor = 0.0
    }

    volume
    {
        thickness = 0.0

        attenuation_distance = inf
        attenuation_color = [1.0, 1.0, 1.0]
    }

    clearcoat
    {
        factor = 0.0
        roughness = 0.0
        normal_scale = 1.0
    }

    sheen
    {
        color = [0.0, 0.0, 0.0]
        roughness = 0.0
    }

    iridescence
    {
        factor = 0.0
        ior = 1.3

        thickness_min = 100.0
        thickness_max = 400.0
    }

    anisotropy
    {
        strength = 0.0
        rotation = 0.0
    }

    dispersion = 0.0

    glow
    {
        strength = 0.0
        radius = 0.0
        falloff = 2.0
    }

    textures
    {
