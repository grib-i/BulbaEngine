        {
            path = "textures/stone_basecolor.png"

            uv_set = 0

            offset = [0.0, 0.0]
            scale = [1.0, 1.0]
            rotation = 0.0

            wrap_u = repeat
            wrap_v = repeat

            min_filter = linear
            mag_filter = linear
        }

        metallic_roughness
        {
